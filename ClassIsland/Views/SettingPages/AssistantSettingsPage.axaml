<controls:SettingsPageBase x:Class="ClassIsland.Views.SettingPages.AssistantSettingsPage"
                           xmlns="https://github.com/avaloniaui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           xmlns:local="clr-namespace:ClassIsland.Views.SettingPages"
                           xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
                           xmlns:ci="http://classisland.tech/schemas/xaml/core"
                           xmlns:fa="using:FluentAvalonia.UI.Controls"
                           mc:Ignorable="d"
                           d:DesignHeight="900" d:DesignWidth="800"
                           d:DataContext="{d:DesignInstance local:AssistantSettingsPage}">
    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro" Tag="CanPolicyDisable">
            <!-- 头部 -->
            <Border Margin="0 0 0 12" Padding="20" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="52" Height="52" CornerRadius="26"
                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <ci:FluentIcon Glyph="&#xE275;" FontSize="28"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16 0" VerticalAlignment="Center">
                        <TextBlock Text="AI 助手" Theme="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock TextWrapping="Wrap" Margin="0 4 0 0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="连接 DeepSeek Harness（DSH）或任意 OpenAI 兼容接口，用自然语言查询课表、天气、联网搜索，或让 AI 帮你操作电脑、配置 ClassIsland；喊一声唤醒词就来。" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="accent" VerticalAlignment="Center"
                            Click="ButtonOpenAssistant_OnClick">
                        <ci:IconText Glyph="&#xE276;" Text="打开助手" />
                    </Button>
                </Grid>
            </Border>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE276;}"
                                 Header="启用 AI 助手"
                                 Description="关闭后将无法使用 AI 对话、语音助手和“询问 AI 助手”行动。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.IsEnabled, Mode=TwoWay}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <!-- 后端 -->
            <ci:IconText Glyph="&#xEDC7;" Text="连接" Margin="0 16 0 4" />
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xEDC7;}"
                                 Header="对话后端"
                                 Description="DSH 自带联网搜索、网页读取与电脑操作能力，并可登录 DeepSeek 账号使用；内置 API 只需要一个 API Key。"
                                 IsExpanded="True">
                <fa:SettingsExpanderItem>
                    <StackPanel Spacing="4">
                        <RadioButton GroupName="AssistantBackend" IsChecked="{Binding Settings.IsDshBackend, Mode=TwoWay}"
                                     Content="DeepSeek Harness（DSH，推荐）" />
                        <RadioButton GroupName="AssistantBackend" IsChecked="{Binding Settings.IsApiBackend, Mode=TwoWay}"
                                     Content="内置 API（OpenAI 兼容接口）" />
                    </StackPanel>
                </fa:SettingsExpanderItem>
            </fa:SettingsExpander>

            <!-- DSH -->
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE275;}"
                                 Header="DeepSeek Harness（DSH）"
                                 Description="需要 Node.js 18 或更高版本。首次连接会自动下载 DSH，可能需要一两分钟。"
                                 IsVisible="{Binding Settings.IsDshBackend}"
                                 IsExpanded="True">
                <fa:SettingsExpander.Footer>
                    <Button Click="ButtonDshLogin_OnClick">
                        <ci:IconText Glyph="&#xF4C3;" Text="登录 DSH 账号" />
                    </Button>
                </fa:SettingsExpander.Footer>
                <fa:SettingsExpanderItem Content="登录说明"
                                         Description="点击“登录 DSH 账号”会在浏览器中打开 DSH 网页版，在其中登录 DeepSeek 账号即可；登录信息保存在本机 DSH 中，助手会自动使用。" />
                <fa:SettingsExpanderItem Content="启动命令"
                                         Description="已全局安装 DSH（npm i -g @deepseek-ai/dsh）时可改为 dsh。">
                    <fa:SettingsExpanderItem.Footer>
                        <TextBox MinWidth="300" Text="{Binding Settings.DshCommand, Mode=TwoWay}" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="工作目录" Description="DSH 读写文件的默认位置，留空使用用户主目录。">
                    <fa:SettingsExpanderItem.Footer>
                        <TextBox MinWidth="300" Text="{Binding Settings.DshWorkingDirectory, Mode=TwoWay}"
                                 Watermark="（用户主目录）" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="让 DSH 使用 ClassIsland 工具"
                                         Description="DSH 可以查询课表、天气，显示提醒，打开 ClassIsland 设置。仅本机可访问，并使用随机令牌保护。">
                    <fa:SettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.IsDshClassIslandToolsEnabled, Mode=TwoWay}" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="未登录时使用 API Key"
                                         Description="把下方“连接模板”中填写的 DeepSeek API Key 传给 DSH。">
                    <fa:SettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.IsDshApiKeyPassThroughEnabled, Mode=TwoWay}" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="测试连接">
                    <fa:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" MaxWidth="320" TextWrapping="Wrap"
                                       Text="{Binding TestResult}" />
                            <fa:ProgressRing Width="18" Height="18" IsIndeterminate="True"
                                             IsVisible="{Binding IsTesting}" />
                            <Button Content="重新连接" Click="ButtonDshReconnect_OnClick" IsEnabled="{Binding !IsTesting}" />
                            <Button Content="测试" Click="ButtonTest_OnClick" IsEnabled="{Binding !IsTesting}" />
                        </StackPanel>
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
            </fa:SettingsExpander>

            <!-- 连接模板 -->
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xEDC7;}"
                                 Header="连接模板（内置 API）"
                                 Description="选择模板后接口地址和模型会自动填充，只需填写 API Key 即可连接。"
                                 IsExpanded="{Binding Settings.IsApiBackend, Mode=OneWay}">
                <fa:SettingsExpander.Footer>
                    <ComboBox MinWidth="220" x:Name="ComboBoxTemplate"
                              ItemsSource="{Binding Templates}"
                              SelectionChanged="ComboBoxTemplate_OnSelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </fa:SettingsExpander.Footer>
                <fa:SettingsExpanderItem Content="API Key"
                                         Description="密钥仅保存在本机的配置文件中。"
                                         IsVisible="{Binding Settings.Template.RequiresApiKey}">
                    <fa:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox MinWidth="300" PasswordChar="•"
                                     Text="{Binding Settings.ApiKey, Mode=TwoWay}"
                                     Watermark="粘贴 API Key（sk-...）" />
                            <Button Click="ButtonGetApiKey_OnClick"
                                    IsVisible="{Binding !Settings.IsCustomProvider}">
                                <ci:IconText Glyph="&#xEA01;" Text="获取 API Key" />
                            </Button>
                        </StackPanel>
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <!-- 内置模板：只读显示自动填充的值 -->
                <fa:SettingsExpanderItem Content="接口地址（自动填充）" IsVisible="{Binding !Settings.IsCustomProvider}">
                    <fa:SettingsExpanderItem.Footer>
                        <SelectableTextBlock Text="{Binding Settings.EffectiveApiBaseUrl}"
                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="模型（自动填充）" IsVisible="{Binding !Settings.IsCustomProvider}">
                    <fa:SettingsExpanderItem.Footer>
                        <SelectableTextBlock Text="{Binding Settings.EffectiveModel}"
                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <!-- 自定义模板：手动填写 -->
                <fa:SettingsExpanderItem Content="接口地址（Base URL）"
                                         Description="任何兼容 OpenAI /chat/completions 的服务均可使用。"
                                         IsVisible="{Binding Settings.IsCustomProvider}">
                    <fa:SettingsExpanderItem.Footer>
                        <TextBox MinWidth="300" Text="{Binding Settings.ApiBaseUrl, Mode=TwoWay}"
                                 Watermark="https://api.example.com/v1" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="模型" Description="模型需要支持工具调用（Function Calling）才能操作电脑。"
                                         IsVisible="{Binding Settings.IsCustomProvider}">
                    <fa:SettingsExpanderItem.Footer>
                        <TextBox MinWidth="300" Text="{Binding Settings.Model, Mode=TwoWay}"
                                 Watermark="model-name" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="温度" Description="越低越稳定，越高越有创意。">
                    <fa:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Slider Width="200" Minimum="0" Maximum="1.5" TickFrequency="0.1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.Temperature, Mode=TwoWay}" />
                            <TextBlock VerticalAlignment="Center" MinWidth="28"
                                       Text="{Binding Settings.Temperature, StringFormat={}{0:0.0}}" />
                        </StackPanel>
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="测试连接" IsVisible="{Binding Settings.IsApiBackend}">
                    <fa:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" MaxWidth="320" TextWrapping="Wrap"
                                       Text="{Binding TestResult}" />
                            <fa:ProgressRing Width="18" Height="18" IsIndeterminate="True"
                                             IsVisible="{Binding IsTesting}" />
                            <Button Content="测试" Click="ButtonTest_OnClick" IsEnabled="{Binding !IsTesting}" />
                        </StackPanel>
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
            </fa:SettingsExpander>

            <!-- 能力 -->
            <ci:IconText Glyph="&#xEF4F;" Text="能力与安全" Margin="0 16 0 4" />
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xF4C1;}"
                                 Header="完全控制电脑（授予全部权限）"
                                 Description="开启后助手可以执行所有桌面操作和命令行命令，不再弹窗确认；DSH 以完全访问模式运行，不受工作区限制。网页或文件中的恶意内容也可能借此操作电脑，仅在信任所用模型时开启。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.IsFullAccessEnabled, Mode=TwoWay}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xF4C1;}"
                                 IsEnabled="{Binding !Settings.IsFullAccessEnabled}"
                                 Header="允许 AI 操作电脑"
                                 Description="允许 AI 调用工具：打开程序/网址、调节音量、媒体控制、锁屏、显示桌面、截图、查询课表和天气、显示提醒等。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.IsDesktopToolsEnabled, Mode=TwoWay}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE80C;}"
                                 Header="联网搜索（内置 API）"
                                 Description="允许 AI 使用必应搜索并读取网页。DSH 自带联网工具，不受此开关影响。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.IsWebToolsEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding Settings.AllowDesktopTools}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xF499;}"
                                 IsEnabled="{Binding !Settings.IsFullAccessEnabled}"
                                 Header="允许 AI 执行命令行命令"
                                 Description="高风险：AI 将可以在 cmd / bash 中执行任意命令。仅在你信任所用模型时开启。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.IsCommandToolEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding Settings.IsDesktopToolsEnabled}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xEF4F;}"
                                 IsEnabled="{Binding !Settings.IsFullAccessEnabled}"
                                 Header="高风险操作前确认"
                                 Description="关机/重启、关闭程序、执行命令前弹窗确认。强烈建议保持开启。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.ConfirmDangerousOperations, Mode=TwoWay}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xF00D;}"
                                 Header="朗读 AI 回复"
                                 Description="使用【设置 → 提醒 → 语音】中配置的语音合成服务朗读回复。语音交互时总会朗读。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.IsSpeakReplyEnabled, Mode=TwoWay}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <!-- 语音助手 -->
            <ci:IconText Glyph="&#xED53;" Text="语音助手" Margin="0 16 0 4" />
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xED53;}"
                                 Header="启用语音唤醒"
                                 Description="{Binding VoiceAssistantService.Status, StringFormat=后台监听唤醒词，说出唤醒词后再说出指令。当前状态：{0}}"
                                 IsEnabled="{Binding VoiceAssistantService.IsSupported}">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.IsVoiceAssistantEnabled, Mode=TwoWay}" />
                </fa:SettingsExpander.Footer>
                <fa:SettingsExpanderItem Content="唤醒词" Description="建议使用 3~5 个字、不常见的词，以减少误唤醒。">
                    <fa:SettingsExpanderItem.Footer>
                        <TextBox MinWidth="200" Text="{Binding Settings.WakeWord, Mode=TwoWay}" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="识别语言" Description="需要在系统中安装对应语言的语音识别组件。">
                    <fa:SettingsExpanderItem.Footer>
                        <ComboBox MinWidth="200" SelectedItem="{Binding Settings.RecognitionCulture, Mode=TwoWay}"
                                  ItemsSource="{Binding Cultures}" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="识别置信度阈值" Description="低于此值的识别结果会被忽略。">
                    <fa:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Slider Width="200" Minimum="0.1" Maximum="0.95" TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.RecognitionConfidenceThreshold, Mode=TwoWay}" />
                            <TextBlock VerticalAlignment="Center" MinWidth="28"
                                       Text="{Binding Settings.RecognitionConfidenceThreshold, StringFormat={}{0:0.00}}" />
                        </StackPanel>
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="唤醒时显示助手窗口">
                    <fa:SettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.ShowWindowOnWake, Mode=TwoWay}" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
            </fa:SettingsExpander>

            <!-- 桌面宠物 -->
            <ci:IconText Glyph="&#xE275;" Text="桌面宠物" Margin="0 16 0 4" />
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE275;}"
                                 Header="显示大肥鱼桌宠"
                                 Description="常驻桌面的 Q 版工作宠物，会随助手的状态（聆听、思考、干活、回复）变换动作。单击打开对话，可拖动到任意位置。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.IsPetEnabled, Mode=TwoWay}" />
                </fa:SettingsExpander.Footer>
                <fa:SettingsExpanderItem Content="大小">
                    <fa:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Slider Width="200" Minimum="0.5" Maximum="2" TickFrequency="0.1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.PetScale, Mode=TwoWay}" />
                            <TextBlock VerticalAlignment="Center" MinWidth="28"
                                       Text="{Binding Settings.PetScale, StringFormat={}{0:0.0}x}" />
                        </StackPanel>
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="空闲动画" Description="关闭后桌宠空闲时完全静止，进一步降低资源占用。">
                    <fa:SettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.IsPetAnimationEnabled, Mode=TwoWay}" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="重置位置">
                    <fa:SettingsExpanderItem.Footer>
                        <Button Content="移回右下角" Click="ButtonResetPetPosition_OnClick" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="形象来源"
                                         Description="“大肥鱼”立绘来自 RYANFFY/deepseek-dafeiyu-pet（MIT 许可），为社区二创形象，非 DeepSeek 官方出品。" />
            </fa:SettingsExpander>

            <!-- 高级 -->
            <ci:IconText Glyph="&#xEF27;" Text="高级" Margin="0 16 0 4" />
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xF216;}"
                                 Header="附加系统提示词"
                                 Description="追加到内置提示词之后，可用于设定助手的身份、称呼、回答风格等。">
                <fa:SettingsExpanderItem>
                    <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"
                             Text="{Binding Settings.CustomSystemPrompt, Mode=TwoWay}"
                             Watermark="例如：你是高一（3）班的班级助手，称呼用户为“老师”。" />
                </fa:SettingsExpanderItem>
            </fa:SettingsExpander>
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE990;}"
                                 Header="上下文与超时">
                <fa:SettingsExpanderItem Content="保留的历史消息条数">
                    <fa:SettingsExpanderItem.Footer>
                        <NumericUpDown MinWidth="140" Minimum="2" Maximum="100" Increment="2" FormatString="0"
                                       Value="{Binding Settings.MaxHistoryMessages, Mode=TwoWay}" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="请求超时（秒）">
                    <fa:SettingsExpanderItem.Footer>
                        <NumericUpDown MinWidth="140" Minimum="5" Maximum="600" Increment="5" FormatString="0"
                                       Value="{Binding Settings.RequestTimeoutSeconds, Mode=TwoWay, Converter={x:Static ci:NotNaNConverter.Instance}}" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
            </fa:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</controls:SettingsPageBase>
